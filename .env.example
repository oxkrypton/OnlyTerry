# my.telegram.org 申请的应用凭证
TG_API_ID=12345678
TG_API_HASH=your_32_char_api_hash

# 本地执行 python3 scripts/gen_session.py 后输出的 StringSession
# 等同于账号完全控制权，建议用专用小号
TG_SESSION=your_string_session

# 目标群：@username 或纯数字 ID（如 -1001234567890）
TARGET_GROUP=-1001234567890
# 目标用户：@username 或纯数字 ID
TARGET_USER=trader_bob
