# my.telegram.org 申请的应用凭证
TG_API_ID=12345678
TG_API_HASH=your_32_char_api_hash

# 本地执行 python3 scripts/gen_session.py 后输出的 StringSession
# 等同于账号完全控制权，建议用专用小号
TG_SESSION=your_string_session

# 目标群：@username 或纯数字 ID（如 -1001234567890）
TARGET_GROUP=-1001234567890
# 目标用户：@username 或纯数字 ID
TARGET_USER=trader_bob

# 论坛话题 ID；一个话题一个 session（data/session3/），各自独立游标；0 = 全群
TARGET_TOPIC=3
# 可选：覆盖目录名，默认 session{TARGET_TOPIC}
# SESSION_ID=session3
# 媒体：none=不下图 | target=只下目标用户发的图片（默认）| all=所有人的图片
# 图片存 data/<session>/media/，随 data/ 一起提交到远程仓库
DOWNLOAD_MEDIA=target

# 本地先跑一次全量（远程 CI 只做增量）：
#   TARGET_TOPIC=2 make fetch    首次抓话题2，生成 data/session2/
#   TARGET_TOPIC=3 make fetch    顺带补齐话题3 历史里目标用户缺的图
#   make build                   合并所有 session 重建 dist/

# 完整说明见 server/README.md 和 server/.env.example
PUBLIC_URL=https://alerts.example.com
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=data/service/service.db
IMAGE_DIR=data/service/images
TOKEN_SECRET=replace_with_at_least_32_random_characters
TYPESAFE_API_KEY=your_typesafe_api_key
JEV_MODEL=jev-latest
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Terry Alerts <alerts@example.com>
MESSAGE_WINDOW_MS=120000
SCORE_THRESHOLD=80
RETRY_MS=60000
MAX_BATCH_ATTEMPTS=8
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=25000000
MAX_IMAGES_PER_MESSAGE=6
MAX_SCORING_IMAGES=6
ALLOW_PRIVATE_IMAGE_URLS=false
RESEND_REMOTE_IMAGES=true
CLEANUP_INTERVAL=1h
IMAGE_RETENTION=168h
DB_RETENTION=720h
WS_ENABLED=true
WS_URL=wss://example.com/ws
WS_AUTH_TOKEN=optional_bearer_token
WS_HEADERS_JSON={}
WS_SUBSCRIBE_MESSAGES_JSON=[{"action":"subscribe","channel":"room-us"},{"action":"subscribe","channel":"room-crypto"}]
WS_CHANNEL_MAP_JSON={"room-us":"us_stocks","room-crypto":"crypto"}
TARGET_AUTHOR_IDS=blogger_user_id
