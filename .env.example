# my.telegram.org 申请的应用凭证
TG_API_ID=12345678
TG_API_HASH=your_32_char_api_hash

# 本地执行 python3 scripts/gen_session.py 后输出的 StringSession
# 等同于账号完全控制权，建议用专用小号
TG_SESSION=your_string_session

# 目标群：@username 或纯数字 ID（如 -1001234567890）
TARGET_GROUP=-1001234567890
# 目标用户：@username 或纯数字 ID
TARGET_USER=trader_bob

# 论坛话题 ID；一个话题一个 session（data/session3/），各自独立游标；0 = 全群
TARGET_TOPIC=3
# 可选：覆盖目录名，默认 session{TARGET_TOPIC}
# SESSION_ID=session3
# 媒体：none=不下图 | target=只下目标用户发的图片（默认）| all=所有人的图片
# 图片存 data/<session>/media/，随 data/ 一起提交到远程仓库
DOWNLOAD_MEDIA=target

# 本地先跑一次全量（远程 CI 只做增量）：
#   TARGET_TOPIC=2 make fetch    首次抓话题2，生成 data/session2/
#   TARGET_TOPIC=3 make fetch    顺带补齐话题3 历史里目标用户缺的图
#   make build                   合并所有 session 重建 dist/
