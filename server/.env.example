# 博主发言邮件订阅服务（Go 单二进制）
PUBLIC_URL=https://alerts.example.com
HOST=0.0.0.0
PORT=3000

DATABASE_PATH=data/service/service.db
IMAGE_DIR=data/service/images
TOKEN_SECRET=replace_with_at_least_32_random_characters

TYPESAFE_API_KEY=your_typesafe_api_key
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
RESEND_API_KEY=re_your_resend_api_key
RESEND_BASE_URL=https://api.resend.com
EMAIL_FROM=Terry Alerts <alerts@example.com>

MESSAGE_WINDOW_MS=120000
SCORE_THRESHOLD=80
RETRY_MS=60000
MAX_BATCH_ATTEMPTS=8

# 单并发图片解码，适配 2C2G 小机器
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=25000000
MAX_IMAGES_PER_MESSAGE=6
MAX_SCORING_IMAGES=6
ALLOW_PRIVATE_IMAGE_URLS=false

# true：公开原图 URL 交给 Resend 拉取，避免每个收件人都占用服务器上行带宽
# base64 消息自动回退为服务器上传；私有或快速失效的 URL 需设为 false
RESEND_REMOTE_IMAGES=true

# 内置定时清理：启动时执行一次，之后每小时执行
CLEANUP_INTERVAL=1h
IMAGE_RETENTION=168h
DB_RETENTION=720h

WS_ENABLED=true
WS_URL=wss://example.com/ws
WS_AUTH_TOKEN=optional_bearer_token
WS_HEADERS_JSON={}
WS_SUBSCRIBE_MESSAGES_JSON=[{"action":"subscribe","channel":"room-us"},{"action":"subscribe","channel":"room-crypto"}]
WS_CHANNEL_MAP_JSON={"room-us":"us_stocks","room-crypto":"crypto"}
TARGET_AUTHOR_IDS=blogger_user_id
