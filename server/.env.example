# 博主发言邮件订阅服务（Go 单二进制）
# 带 * 的为必填项，其余均有默认值，可按需覆盖。

# ── 对外地址 ──────────────────────────────────────────────
# * 服务的公网完整地址，用于拼接邮件里的确认/退订链接，生产必须是 HTTPS
PUBLIC_URL=https://alerts.example.com
# GitHub Pages 前端地址：根路径重定向目标，也是唯一放行跨域的来源；留空则不启用
PAGES_URL=https://yourname.github.io
# HTTP 监听地址，默认 0.0.0.0；前置有 Caddy/Nginx 时可改成 127.0.0.1
HOST=0.0.0.0
# HTTP 监听端口，默认 3000
PORT=3000

# ── 存储与密钥 ────────────────────────────────────────────
# SQLite 数据库文件路径，默认 data/service/service.db
DATABASE_PATH=data/service/service.db
# 图片落盘目录，默认 data/service/images
IMAGE_DIR=data/service/images
# * 确认/退订链接的 HMAC 签名密钥，至少 32 个字符，可用 openssl rand -hex 32 生成
TOKEN_SECRET=replace_with_at_least_32_random_characters

# ── TypeSafe JEV 评分 ────────────────────────────────────
# * TypeSafe API 密钥
TYPESAFE_API_KEY=your_typesafe_api_key
# TypeSafe API 地址，默认 https://api.typesafe.ai
TYPESAFE_BASE_URL=https://api.typesafe.ai
# 评分模型名，默认 jev-latest
JEV_MODEL=jev-latest

# ── Resend 邮件 ──────────────────────────────────────────
# * Resend API 密钥
RESEND_API_KEY=re_your_resend_api_key
# Resend API 地址，默认 https://api.resend.com
RESEND_BASE_URL=https://api.resend.com
# 发件人显示名与地址，需使用已在 Resend 验证的域名
EMAIL_FROM=Terry Alerts <alerts@example.com>

# ── 聚合与评分策略 ────────────────────────────────────────
# 每个频道的静默聚合窗口（毫秒），默认 120000（2 分钟），窗口内新发言会顺延
MESSAGE_WINDOW_MS=120000
# 批次自创建起的最长等待（毫秒），默认 900000（15 分钟），须大于 MESSAGE_WINDOW_MS
# 高频发言下静默窗口会被不断顺延，该硬上限保证批次最迟此时封箱打分
MAX_BATCH_WAIT_MS=900000
# 批次最多容纳的消息数，默认 20，达到即封箱，后续消息另起一批
MAX_BATCH_MESSAGES=20
# 投递阈值 0–100，批次得分大于等于该值才发邮件，默认 75
SCORE_THRESHOLD=75
# 批次处理失败后的重试间隔（毫秒），默认 60000
RETRY_MS=60000
# 单个批次最大处理次数，超限标记为 failed 不再重试，默认 8
MAX_BATCH_ATTEMPTS=8

# ── 图片限制 ─────────────────────────────────────────────
# 单并发图片解码，适配 2C2G 小机器
# 单张图片下载大小上限（字节），默认 5242880（5 MB）
MAX_IMAGE_BYTES=5242880
# 单张图片像素上限，默认 25000000（2500 万像素）
MAX_IMAGE_PIXELS=25000000
# 每条消息最多保存的图片张数，默认 6
MAX_IMAGES_PER_MESSAGE=6
# 送 JEV 评分时每批次最多携带的图片张数，默认 6
MAX_SCORING_IMAGES=6
# 是否允许内网/回环图片 URL；生产必须 false，仅本地调试用 true
ALLOW_PRIVATE_IMAGE_URLS=false

# ── 邮件图片投递方式 ──────────────────────────────────────
# true：公开原图 URL 交给 Resend 拉取，避免每个收件人都占用服务器上行带宽
# base64 消息自动回退为服务器上传；私有或快速失效的 URL 需设为 false
RESEND_REMOTE_IMAGES=true

# ── 定时清理 ─────────────────────────────────────────────
# 内置定时清理：启动时执行一次，之后按该周期执行，默认 1h
CLEANUP_INTERVAL=1h
# 图片保留时长，默认 168h（7 天）
IMAGE_RETENTION=168h
# 批次/消息/投递等数据库记录保留时长，默认 720h（30 天）
DB_RETENTION=720h

# ── Telegram 数据源（内置 MTProto 采集器）─────────────────
# 是否启用内置 TG 采集器，默认 true；false 时仅跑 HTTP 与清理
TG_ENABLED=true
# * my.telegram.org 申请的应用凭证（可与 scripts/fetch_tg.py 共用同一组）
TG_API_ID=12345678
TG_API_HASH=your_32_char_api_hash
# * Telethon StringSession，本地执行 python3 scripts/gen_session.py 生成
#   建议为邮件服务单独生成一个全新 session，与抓取脚本互不影响
#   等价于账号完全控制权，请用专用小号，务必保密
TG_SESSION=your_string_session
# gotd 刷新后的 session 落盘路径（用于持久化 DC/salt，纳入备份），默认 data/service/tg.session
TG_SESSION_FILE=data/service/tg.session
# 断线补包断点文件：记录每个群已处理的 pts，重启/断线后据此补回空洞期间的消息（纳入备份）
# gotd updates.Manager 会自动创建与刷新它；多实例不可共享此文件（本服务按单实例部署）
TG_STATE_FILE=data/service/tg.updates.json
# TG 采集与 JEV 评分共用的 SOCKS5 出口（可选）：socks5://host:port 或 socks5h://host:port
# gotd 不读 HTTP_PROXY 环境变量，JEV 的 HTTP 客户端也只认这里；
# 两者都不走代理时留空。若 TypeSafe 返回 451，需把这里指向可用的海外出口。
PROXY=
# 目标群聊 → 内部频道（us_stocks/crypto）的映射（JSON 对象），未映射的消息丢弃
# 固定格式「群号_话题ID」：群号是 Telegram 的裸群 ID（gotd update 里的 PeerChannel.ChannelID，
# 即 Web 链接 #-1001234567890_1 完整 chat_id 去掉 -100 前缀得 1234567890），
TG_CHANNEL_MAP_JSON={"1234567890_1":"us_stocks","1234567890_2":"crypto"}
# 目标博主的数字 user ID，逗号分隔；留空表示处理该群所有作者
TARGET_AUTHOR_IDS=123456789
